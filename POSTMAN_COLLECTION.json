{
  "info": {
    "name": "UserManagementAPI - CRUD Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://localhost:7041" },
    { "key": "token", "value": "techhive-demo-token" },
    { "key": "userId", "value": "1" }
  ],
  "item": [
    {
      "name": "GET all users",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/users"
      }
    },
    {
      "name": "GET user by id",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/users/{{userId}}"
      }
    },
    {
      "name": "POST create user",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Ahmed\",\n  \"lastName\": \"Ali\",\n  \"email\": \"ahmed.ali@example.com\",\n  \"department\": \"IT\"\n}"
        },
        "url": "{{baseUrl}}/api/users"
      }
    },
    {
      "name": "PUT update user",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Ahmed Updated\",\n  \"lastName\": \"Ali\",\n  \"email\": \"ahmed.updated@example.com\",\n  \"department\": \"HR\"\n}"
        },
        "url": "{{baseUrl}}/api/users/{{userId}}"
      }
    },
    {
      "name": "DELETE user",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/users/{{userId}}"
      }
    },
    {
      "name": "401 missing token",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/users"
      }
    },
    {
      "name": "401 invalid token",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer wrong-token" }],
        "url": "{{baseUrl}}/api/users"
      }
    }
  ]
}
